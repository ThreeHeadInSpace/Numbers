# Локальный запуск: скопируйте этот файл в .env. В Amvera используйте «Переменные и секреты».
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000
DATABASE_PATH=./data/chisla.sqlite
# Обязателен постоянный случайный секрет для сохранения сессий после перезапуска.
# Сгенерировать: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=

# Только локально. В production обязательно false.
DEMO_AUTH_ENABLED=true
PAYMENT_MODE=mock
AI_MODE=mock
MOCK_AI_FAILURE=false
LIVE_PAYMENTS_ENABLED=false
LEGAL_READY=false

# Для тестового магазина: PAYMENT_MODE=yookassa, test_ ключ, LIVE_PAYMENTS_ENABLED=false.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Система налогообложения и НДС должны соответствовать вашему магазину / договору.
# 1 здесь — пример «без НДС». Налоговую систему в live необходимо указать явно.
YOOKASSA_TAX_SYSTEM_CODE=
YOOKASSA_VAT_CODE=1

# Для настоящей модели: AI_MODE=deepseek. Модель фиксирована на backend: deepseek-flash.
DEEPSEEK_API_KEY=
AI_TIMEOUT_MS=45000

VK_CLIENT_ID=
VK_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ENABLED=false
# Apple Service ID и подписанный client-secret JWT (ES256), НЕ обычный пароль.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_ID=

# Включайте только за доверенным reverse proxy Amvera, который перезаписывает X-Forwarded-For.
TRUST_PROXY=false
