{
  "name": "chisla-numerology",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && node scripts/build-client.mjs && tsc -p tsconfig.server.json",
    "build:demo": "tsc --noEmit && node scripts/build-demo.mjs",
    "preview:demo": "vite preview --mode pages-demo --host 127.0.0.1",
    "check:demo": "node scripts/check-demo.mjs",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "smoke": "node scripts/smoke-production.mjs",
    "funnel": "node --env-file-if-exists=.env scripts/funnel.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "better-auth": "^1.7.10",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
